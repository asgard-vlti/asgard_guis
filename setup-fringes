#!/usr/bin/env python3
"""Open and arrange the Fringes GUIs on the current two-monitor X desktop."""

import fcntl
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass


MONITOR_PATTERN = re.compile(
    r"^(\S+) connected( primary)? (\d+)x(\d+)([+-]\d+)([+-]\d+)"
)
TREE_WINDOW_PATTERN = re.compile(
    r'^\s*(0x[0-9a-fA-F]+) "([^"]*)": \((.*)\)\s+(\d+)x(\d+)\S*\s+(\S+)\s*$'
)
MIMIR_BIN = "/home/asg/.conda/envs/asgard/bin"
WINDOW_KEYS = (
    "h_guis",
    "rtd",
    "text",
    "shortcuts",
    "dmview",
    "logs",
    "status",
    "engineering",
    "terminal",
)


@dataclass(frozen=True)
class Monitor:
    name: str
    x: int
    y: int
    width: int
    height: int
    primary: bool


@dataclass(frozen=True)
class Window:
    wid: str
    desktop: int
    pid: int
    x: int
    y: int
    width: int
    height: int
    wm_class: str
    title: str


@dataclass(frozen=True)
class Geometry:
    x: int
    y: int
    width: int
    height: int


def parse_monitors(output):
    monitors = []
    for line in output.splitlines():
        match = MONITOR_PATTERN.match(line)
        if match:
            name, primary, width, height, x, y = match.groups()
            monitors.append(
                Monitor(name, int(x), int(y), int(width), int(height), bool(primary))
            )
    return sorted(monitors, key=lambda monitor: (monitor.x, monitor.y))


def parse_current_desktop(output):
    for line in output.splitlines():
        fields = line.split()
        if len(fields) > 1 and fields[1] == "*":
            return int(fields[0])
    raise RuntimeError("Cannot identify the active X workspace")


def parse_windows(output):
    windows = []
    for line in output.splitlines():
        fields = line.split(maxsplit=9)
        if len(fields) < 10:
            continue
        try:
            wid, desktop, pid, x, y, width, height = fields[:7]
            windows.append(
                Window(
                    wid,
                    int(desktop),
                    int(pid),
                    int(x),
                    int(y),
                    int(width),
                    int(height),
                    fields[7],
                    fields[9],
                )
            )
        except ValueError:
            continue
    return windows


def parse_tree_windows(output, desktop):
    windows = []
    for line in output.splitlines():
        match = TREE_WINDOW_PATTERN.match(line)
        if match is None:
            continue
        wid, title, class_hint, width, height, absolute = match.groups()
        coordinates = re.findall(r"[+-]-?\d+", absolute)
        if len(coordinates) != 2:
            continue
        class_parts = re.findall(r'"([^"]*)"', class_hint)
        windows.append(
            Window(
                wid,
                desktop,
                0,
                int(coordinates[0].replace("+-", "-")),
                int(coordinates[1].replace("+-", "-")),
                int(width),
                int(height),
                ".".join(class_parts),
                title,
            )
        )
    return windows


def matches(key, window):
    title = window.title
    if key == "terminal":
        return "setupfringesmimir" in window.wm_class.lower()
    if key == "engineering":
        return (
            "Heimdallr/Baldr/Solarstein" in title
            or "Asgard alignment engineering GUI" in title
        )
    prefixes = {
        "text": "Asgard servers text interface:",
        "dmview": "DM SHM Viewer - beam 1, 2, 3, 4",
        "logs": "Asgard log viewer:",
    }
    titles = {
        "h_guis": "Heimdallr Real-Time Plots",
        "rtd": "Asgard CRED1 viewer",
        "shortcuts": "ASGARD Shortcuts",
        "status": "Watchdog Status",
    }
    if key in prefixes:
        return title.startswith(prefixes[key])
    return title == titles[key]


def find_window(key, windows, desktop):
    candidates = [window for window in windows if matches(key, window)]
    candidates.sort(key=lambda window: window.desktop != desktop)
    return candidates[0] if candidates else None


def missing_keys(windows, desktop):
    return [key for key in WINDOW_KEYS if find_window(key, windows, desktop) is None]


def wait_for_windows(read_windows, desktop, timeout=30, clock=time.monotonic, pause=time.sleep):
    deadline = clock() + timeout
    while True:
        windows = read_windows()
        if not missing_keys(windows, desktop) or clock() >= deadline:
            return windows
        pause(0.5)


def launch_command(key, op_user, display, xterm_opts):
    mimir_commands = {
        "shortcuts": ["shortcuts"],
        "dmview": ["dmview", "-1"],
        "logs": ["logs-client"],
    }
    wag_commands = {
        "h_guis": ["h-guis"],
        "rtd": ["cred1view"],
        "text": ["text-clients"],
        "status": ["status-mimir"],
    }
    if key in mimir_commands:
        binary, *arguments = mimir_commands[key]
        return ["ssh", "-XC", "mimir", MIMIR_BIN + "/" + binary] + arguments
    if key in wag_commands:
        return wag_commands[key]
    if key == "terminal":
        return (
            ["xterm"]
            + xterm_opts
            + ["-name", "SetupFringesMimir", "-title", "Mimir terminal", "-e", "mimir"]
        )
    if key == "engineering":
        return [
            "ssh",
            "-XY",
            "-t",
            op_user + "@wgsgb1",
            "google-chrome",
            "--user-data-dir=/home/{}/chrome-conf/ITS/{}".format(op_user, display),
            "--profile-directory=ITS",
            "--new-window",
            "http://wag.pl.eso.org:8501",
            "--window-name=Heimdallr/Baldr/Solarstein",
        ]
    raise ValueError("Unknown window: " + key)


def geometry_for(key, left, right):
    if key == "h_guis":
        return None
    if key == "rtd":
        return Geometry(left.x + 8, left.y + 8, 850, 360)
    if key == "text":
        width = min(700, max(400, int(left.width * 0.29)))
        height = min(500, int(left.height * 0.55))
        return Geometry(left.x + 8, left.y + left.height - height - 40, width, height)
    if key == "shortcuts":
        text = geometry_for("text", left, right)
        width = min(451, max(300, int(left.width * 0.25)))
        height = min(667, left.height - 56)
        return Geometry(
            text.x + text.width + 8,
            left.y + left.height - height - 40,
            width,
            height,
        )

    max_right = right.x + right.width - 8
    max_bottom = right.y + right.height - 40
    if key == "dmview":
        width = min(613, right.width // 2 - 16)
        height = min(431, int(right.height * 0.45))
        return Geometry(right.x + 8, right.y + int(right.height * 0.30), width, height)
    if key == "logs":
        width = min(1000, int(right.width * 0.55) - 16)
        height = min(700, int(right.height * 0.28))
        return Geometry(right.x + 8, max_bottom - height, width, height)
    if key == "status":
        width = min(950, int(right.width * 0.43))
        height = min(650, int(right.height * 0.53))
        return Geometry(max_right - width, right.y + 8, width, height)
    if key in ("engineering", "terminal"):
        return None
    raise ValueError("Unknown window: " + key)


def format_geometry(geometry):
    return "{}x{}{:+d}{:+d}".format(
        geometry.width, geometry.height, geometry.x, geometry.y
    )


def command_with_geometry(command, key, left, right):
    geometry = geometry_for(key, left, right)
    if geometry is None:
        return command
    setting = "ASGARD_SETUP_FRINGES_GEOMETRY=" + format_geometry(geometry)
    if command[0] == "ssh":
        host = command.index("mimir")
        return command[: host + 1] + ["env", setting] + command[host + 1 :]
    return ["env", setting] + command


def command_output(command):
    return subprocess.check_output(command, text=True, stderr=subprocess.PIPE)


def read_windows(desktop):
    windows = parse_windows(command_output(["wmctrl", "-lpGx"]))
    if windows:
        return windows
    return parse_tree_windows(command_output(["xwininfo", "-root", "-tree"]), desktop)


def error_detail(error):
    detail = getattr(error, "stderr", None)
    if isinstance(detail, bytes):
        detail = detail.decode(errors="replace")
    return detail.strip() if detail else str(error)


def run(op_user, display, xterm_opts):
    for binary in ("xrandr", "wmctrl", "xwininfo", "ssh", "xterm"):
        if shutil.which(binary) is None:
            raise RuntimeError("Required command is missing on wag: " + binary)

    monitors = parse_monitors(command_output(["xrandr", "--query"]))
    if len(monitors) != 2:
        raise RuntimeError("Expected two active X monitors; found {}".format(len(monitors)))
    left, right = monitors
    desktop = parse_current_desktop(command_output(["wmctrl", "-d"]))
    windows = read_windows(desktop)
    launched = []
    for key in missing_keys(windows, desktop):
        command = command_with_geometry(
            launch_command(key, op_user, display, xterm_opts), key, left, right
        )
        try:
            subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            launched.append(key)
        except OSError as error:
            print("Could not launch {}: {}".format(key, error), file=sys.stderr)

    if launched:
        windows = wait_for_windows(lambda: read_windows(desktop), desktop)

    missing = missing_keys(windows, desktop)

    if missing:
        print("Windows did not appear: " + ", ".join(missing), file=sys.stderr)
    return 1 if missing else 0


def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    display = os.environ.get("DISPLAY")
    if not args or not args[0] or not display:
        print(
            "Usage: DISPLAY=host:screen setup-fringes OP_USER [XTERM_OPTS ...]",
            file=sys.stderr,
        )
        return 2
    try:
        lock_path = os.path.expanduser("~/.setup-fringes.lock")
        with open(lock_path, "a") as lock_file:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
            return run(args[0], display, args[1:])
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
        print("Setup Fringes: " + error_detail(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
